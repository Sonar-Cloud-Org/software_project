<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="950.0" prefHeight="650.0" stylesheets="@styles.css" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.najah.software.presentation.CustomerController">
    <!-- Header Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #111827; -fx-padding: 10 15 10 15; -fx-border-color: #374151; -fx-border-width: 0 0 1px 0;">
            <children>
                <Label fx:id="customerWelcomeLabel" text="Welcome Customer: Loading..." styleClass="label-bold" style="-fx-text-fill: #D4AF37;"/>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Logout" onAction="#handleLogout" styleClass="button-danger"/>
            </children>
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <GridPane hgap="10.0" vgap="10.0" style="-fx-padding: 10;">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="60.0" />
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="40.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints percentHeight="60.0" vgrow="SOMETIMES" />
                <RowConstraints percentHeight="40.0" vgrow="SOMETIMES" />
            </rowConstraints>

            <children>
                <!-- Available fleet table (Left Top) -->
                <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <children>
                        <Label text="Available Fleet for Rent" styleClass="label-bold" style="-fx-text-fill: #D4AF37;"/>
                        <TableView fx:id="fleetTable" VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colFleetId" text="ID" prefWidth="60.0"/>
                                <TableColumn fx:id="colFleetType" text="Type" prefWidth="100.0"/>
                                <TableColumn fx:id="colFleetBrand" text="Brand" prefWidth="100.0"/>
                                <TableColumn fx:id="colFleetModel" text="Model" prefWidth="100.0"/>
                                <TableColumn fx:id="colFleetPlate" text="Plate" prefWidth="90.0"/>
                                <TableColumn fx:id="colFleetRate" text="Daily Rate" prefWidth="80.0"/>
                                <TableColumn fx:id="colFleetExtra" text="Extra Details" prefWidth="120.0"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>

                <!-- Rent selected vehicle (Right Top) -->
                <VBox spacing="15.0" styleClass="card-panel" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <children>
                        <Label text="Rent Selected Vehicle" styleClass="label-bold" style="-fx-text-fill: #D4AF37;"/>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Vehicle Select:"/>
                                <ComboBox fx:id="selectedVehicleCombo" prefWidth="Infinity"/>
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Duration (1-30 days):"/>
                                <TextField fx:id="durationField" promptText="Enter days"/>
                            </children>
                        </VBox>

                        <Button text="Confirm Booking" onAction="#handleRentVehicle" prefWidth="Infinity" styleClass="button"/>
                    </children>
                </VBox>

                <!-- My Active Rental Records (Bottom Full Width) -->
                <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                    <children>
                        <Label text="My Active Rental Records" styleClass="label-bold" style="-fx-text-fill: #D4AF37;"/>
                        <TableView fx:id="myRentalsTable" VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colMyRentId" text="Rental ID" prefWidth="150.0"/>
                                <TableColumn fx:id="colMyVehId" text="Vehicle ID" prefWidth="150.0"/>
                                <TableColumn fx:id="colMyVehName" text="Brand &amp; Model" prefWidth="250.0"/>
                                <TableColumn fx:id="colMyRentStart" text="Start Date" prefWidth="180.0"/>
                                <TableColumn fx:id="colMyRentDue" text="Expected Return Date" prefWidth="180.0"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </GridPane>
    </center>
</BorderPane>
