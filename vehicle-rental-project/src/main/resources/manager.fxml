<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="950.0" prefHeight="650.0" stylesheets="@styles.css" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.najah.software.presentation.ManagerController">
    <!-- Header Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #111827; -fx-padding: 10 15 10 15; -fx-border-color: #374151; -fx-border-width: 0 0 1px 0;">
            <children>
                <Label text="Manager Panel Dashboard" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #D4AF37;"/>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Logout" onAction="#handleLogout" styleClass="button-danger"/>
            </children>
        </HBox>
    </top>

    <!-- Content -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <!-- Tab 1: Vehicles catalog -->
                <Tab text="Vehicles Inventory">
                    <content>
                        <BorderPane style="-fx-padding: 10;">
                            <center>
                                <TableView fx:id="vehiclesTable" prefWidth="600.0">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colVehId" text="ID" prefWidth="70.0"/>
                                        <TableColumn fx:id="colVehType" text="Type" prefWidth="100.0"/>
                                        <TableColumn fx:id="colVehBrand" text="Brand" prefWidth="100.0"/>
                                        <TableColumn fx:id="colVehModel" text="Model" prefWidth="100.0"/>
                                        <TableColumn fx:id="colVehPlate" text="Plate" prefWidth="100.0"/>
                                        <TableColumn fx:id="colVehRate" text="Daily Rate" prefWidth="90.0"/>
                                        <TableColumn fx:id="colVehStatus" text="Status" prefWidth="90.0"/>
                                        <TableColumn fx:id="colVehExtra" text="Extra" prefWidth="120.0"/>
                                    </columns>
                                </TableView>
                            </center>
                            <right>
                                <VBox spacing="10.0" styleClass="card-panel" prefWidth="250.0" style="-fx-margin-left: 10;">
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                                    </padding>
                                    <children>
                                        <Label text="Add New Vehicle" styleClass="label-bold" style="-fx-text-fill: #D4AF37;"/>
                                        
                                        <Label text="Type:"/>
                                        <ComboBox fx:id="vehTypeCombo" prefWidth="Infinity"/>

                                        <Label text="Vehicle ID:"/>
                                        <TextField fx:id="vehIdField"/>

                                        <Label text="Brand:"/>
                                        <TextField fx:id="vehBrandField"/>

                                        <Label text="Model:"/>
                                        <TextField fx:id="vehModelField"/>

                                        <Label text="Plate:"/>
                                        <TextField fx:id="vehPlateField"/>

                                        <Label text="Daily Rate:"/>
                                        <TextField fx:id="vehRateField"/>

                                        <Label text="Battery % (EV):"/>
                                        <TextField fx:id="vehBattField" text="100"/>

                                        <Button text="Save Vehicle" onAction="#handleSaveVehicle" prefWidth="Infinity" styleClass="button-success"/>
                                    </children>
                                    <BorderPane.margin>
                                        <Insets left="10.0" />
                                    </BorderPane.margin>
                                </VBox>
                            </right>
                        </BorderPane>
                    </content>
                </Tab>

                <!-- Tab 2: Rentals tracker -->
                <Tab text="Rental Transactions">
                    <content>
                        <BorderPane style="-fx-padding: 10;">
                            <center>
                                <TableView fx:id="rentalsTable">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colRentId" text="Rental ID" prefWidth="90.0"/>
                                        <TableColumn fx:id="colRentCustId" text="Customer" prefWidth="90.0"/>
                                        <TableColumn fx:id="colRentVehId" text="Vehicle" prefWidth="90.0"/>
                                        <TableColumn fx:id="colRentStart" text="Start Date" prefWidth="110.0"/>
                                        <TableColumn fx:id="colRentDue" text="Due Date" prefWidth="110.0"/>
                                        <TableColumn fx:id="colRentReturned" text="Returned Date" prefWidth="110.0"/>
                                        <TableColumn fx:id="colRentCost" text="Cost" prefWidth="90.0"/>
                                        <TableColumn fx:id="colRentStatus" text="Status" prefWidth="90.0"/>
                                    </columns>
                                </TableView>
                            </center>
                            <bottom>
                                <HBox spacing="10.0" styleClass="card-panel" style="-fx-padding: 10; -fx-margin-top: 10;">
                                    <BorderPane.margin>
                                        <Insets top="10.0" />
                                    </BorderPane.margin>
                                    <children>
                                        <Button text="Process Return &amp; Billing" onAction="#handleProcessReturn" styleClass="button-warning"/>
                                        <Button text="Trigger Expiry Alerts" onAction="#handleTriggerAlerts" styleClass="button"/>
                                    </children>
                                </HBox>
                            </bottom>
                        </BorderPane>
                    </content>
                </Tab>

                <!-- Tab 3: Customers -->
                <Tab text="Customers Database">
                    <content>
                        <BorderPane style="-fx-padding: 10;">
                            <center>
                                <TableView fx:id="customersTable">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colCustId" text="Customer ID" prefWidth="120.0"/>
                                        <TableColumn fx:id="colCustName" text="Name" prefWidth="200.0"/>
                                        <TableColumn fx:id="colCustEmail" text="Email Address" prefWidth="250.0"/>
                                        <TableColumn fx:id="colCustAge" text="Age" prefWidth="100.0"/>
                                        <TableColumn fx:id="colCustLicense" text="License Type" prefWidth="150.0"/>
                                    </columns>
                                </TableView>
                            </center>
                        </BorderPane>
                    </content>
                </Tab>

                <!-- Tab 4: Logs area -->
                <Tab text="Notifications Log">
                    <content>
                        <BorderPane style="-fx-padding: 10;">
                            <center>
                                <TextArea fx:id="logsArea" prefWidth="200.0" prefHeight="200.0" editable="false" />
                            </center>
                            <bottom>
                                <HBox spacing="10.0" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                                    <children>
                                        <Button text="Clear Log" onAction="#handleClearLog" styleClass="button-danger"/>
                                    </children>
                                </HBox>
                            </bottom>
                        </BorderPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
